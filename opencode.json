{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "architect",
  "instructions": ["HANDOFF.md"],
  "permissions": [
    { "action": "shell", "resource": "git push*", "effect": "allow" }
  ],
  "mcp": {
    "timeout": {
      "startup": 180000
    },
    "datum": {
      "type": "local",
      "command": ["cargo", "run", "--quiet", "--release", "-p", "datum-cli", "--", "mcp"],
      "enabled": true
    }
  }
}
