{
  "name": "Center rectangle",
  "description": "A rectangle by its centre and a corner: construction diagonals meet at the centre",
  "anchors": ["o", "c"],
  "sketch": {
    "points": {"o": [0, 0], "a": [-1, -1], "b": [1, -1], "c": [1, 1], "d": [-1, 1]},
    "lines": {
      "bottom": {"from": "a", "to": "b"},
      "right": {"from": "b", "to": "c"},
      "top": {"from": "c", "to": "d"},
      "left": {"from": "d", "to": "a"},
      "diagonal": {"from": "a", "to": "c", "construction": true},
      "other_diagonal": {"from": "b", "to": "d", "construction": true}
    },
    "constraints": [
      {"type": "horizontal", "line": "bottom"},
      {"type": "vertical", "line": "right"},
      {"type": "horizontal", "line": "top"},
      {"type": "vertical", "line": "left"},
      {"type": "midpoint", "point": "o", "line": "diagonal"},
      {"type": "midpoint", "point": "o", "line": "other_diagonal"}
    ]
  }
}
