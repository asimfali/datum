{
  "format": "datum/1",
  "parameters": {"d": 20},
  "features": [
    {
      "name": "outline",
      "op": "sketch",
      "sketch": {
        "points": {"a": [0, 0], "b": [100, 0], "c": [100, 60], "d": [0, 60], "o": [50, 30]},
        "lines": {"ab": {"from": "a", "to": "b"}, "bc": {"from": "b", "to": "c"}, "cd": {"from": "c", "to": "d"}, "da": {"from": "d", "to": "a"}},
        "circles": {"hole": {"center": "o", "diameter": "d"}},
        "constraints": [{"type": "fix", "point": "a"}, {"type": "fix", "point": "b"}, {"type": "fix", "point": "c"}, {"type": "fix", "point": "d"}, {"type": "fix", "point": "o"}]
      }
    },
    {"name": "block", "op": "extrude", "inputs": ["outline"], "z0": 0, "z1": 40},
    {"name": "mid", "op": "plane", "base": "xy", "offset": 15},
    {"name": "cut", "op": "sketch", "inputs": ["mid", "block"], "sketch": {"points": {}}, "project": {"s": {"from": "block", "section": true}}},
    {"name": "slice", "op": "extrude", "inputs": ["cut"], "z0": 0, "z1": 2}
  ]
}
