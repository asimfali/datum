{
  "format": "datum/1",
  "parameters": {
    "nx": 100,
    "ny": 50,
    "pitch_x": 10,
    "pitch_y": 12,
    "hole": 5,
    "margin": 15,
    "t": 3,
    "w": "2 * margin + (nx - 1) * pitch_x",
    "h": "2 * margin + (ny - 1) * pitch_y"
  },
  "features": [
    {"name": "outline", "op": "sketch", "sketch": {
      "points": {"a": [0, 0], "b": [1000, 0], "c": [1000, 600], "d": [0, 600]},
      "lines": {"bottom": {"from": "a", "to": "b"}, "right": {"from": "b", "to": "c"}, "top": {"from": "c", "to": "d"}, "left": {"from": "d", "to": "a"}},
      "constraints": [
        {"type": "fix", "point": "a"},
        {"type": "horizontal", "line": "bottom"}, {"type": "vertical", "line": "right"},
        {"type": "horizontal", "line": "top"}, {"type": "vertical", "line": "left"},
        {"type": "length", "line": "bottom", "value": "w"}, {"type": "length", "line": "left", "value": "h"}
      ]}},
    {"name": "panel", "op": "extrude", "inputs": ["outline"], "z0": 0, "z1": "t"},
    {"name": "hole_outline", "op": "sketch", "sketch": {
      "points": {"p": [0, 0], "q": [5, 0], "r": [5, 5], "s": [0, 5]},
      "lines": {"k1": {"from": "p", "to": "q"}, "k2": {"from": "q", "to": "r"}, "k3": {"from": "r", "to": "s"}, "k4": {"from": "s", "to": "p"}},
      "constraints": [
        {"type": "fix", "point": "p"},
        {"type": "horizontal", "line": "k1"}, {"type": "vertical", "line": "k2"},
        {"type": "horizontal", "line": "k3"}, {"type": "vertical", "line": "k4"},
        {"type": "equal", "lines": ["k1", "k2"]}, {"type": "length", "line": "k1", "value": "hole"}
      ]}},
    {"name": "punch", "op": "extrude", "inputs": ["hole_outline"], "z0": 0, "z1": "t"},
    {"name": "first_punch", "op": "transform", "inputs": ["punch"], "translate": ["margin - hole / 2", "margin - hole / 2", 0]},
    {"name": "punches", "op": "pattern_grid", "inputs": ["first_punch"], "count": ["nx", "ny"], "step": [["pitch_x", 0, 0], [0, "pitch_y", 0]]},
    {"name": "perforated", "op": "boolean", "inputs": ["panel", "punches"], "kind": "difference"}
  ]
}
